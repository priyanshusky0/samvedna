# Copy to .env and fill in. Never commit .env.
# Postgres in docker-compose; SQLite works for quick local dev.
DATABASE_URL=sqlite:///./samvedna.db
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (optional:
# without it the app falls back to FIRMS' public 7-day South Asia CSV).
FIRMS_MAP_KEY=
# Set to false to disable the in-process APScheduler (e.g. when running scripts).
ENABLE_SCHEDULER=true
CONTACT_EMAIL=
